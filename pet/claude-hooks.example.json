{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\SEU_USUARIO\\.glzr\\zebar\\zebar-widgets\\pet\\hook.ps1",
              "working"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\SEU_USUARIO\\.glzr\\zebar\\zebar-widgets\\pet\\hook.ps1",
              "working"
            ],
            "async": true
          }
        ]
      }
    ],
    "Notification": [
